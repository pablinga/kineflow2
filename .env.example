# Public browser variables
# These values are safe to expose in the client bundle.
NEXT_PUBLIC_SUPABASE_URL=https://example-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=example-public-anon-key

# Private server variables
# No private variables are required by the app today.
# Do not add NEXT_PUBLIC_ to secrets such as service role keys, webhook secrets,
# payment provider access tokens, database passwords, or API credentials.

# Future Mercado Pago integration, server-side only:
# MERCADO_PAGO_ACCESS_TOKEN=TEST-example-access-token
# MERCADO_PAGO_WEBHOOK_SECRET=example-webhook-secret
