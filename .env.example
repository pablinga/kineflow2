# Public browser variables
# These values are safe to expose in the client bundle.
NEXT_PUBLIC_SUPABASE_URL=https://example-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=example-public-anon-key
NEXT_PUBLIC_APP_URL=https://qa.kineflow.ar
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-example-public-key
NEXT_PUBLIC_MP_PREAPPROVAL_PLAN_ID=example-preapproval-plan-id
NEXT_PUBLIC_ENABLE_CLINIC_FEATURES=false
# Feature flag: enables WhatsApp notifications (consent checkbox, confirmation and reminder messages). Default false/unset = disabled.
NEXT_PUBLIC_WHATSAPP_ENABLED=false
# Controls public login/register links on the marketing pages.
NEXT_PUBLIC_SIGNUPS_ENABLED=true
# Optional hard switches for direct /registro and /login access.
NEXT_PUBLIC_ACCOUNT_CREATION_ENABLED=true
NEXT_PUBLIC_LOGIN_ENABLED=true
NEXT_PUBLIC_PUBLIC_AUTH_LINKS_VISIBLE=true

# Private server variables
# Do not add NEXT_PUBLIC_ to secrets such as service role keys, webhook secrets,
# payment provider access tokens, database passwords, or API credentials.
SUPABASE_SERVICE_ROLE_KEY=example-service-role-key

# Mercado Pago integration, server-side only:
MERCADOPAGO_ACCESS_TOKEN=TEST-example-access-token
MERCADOPAGO_TEST_PAYER_EMAIL=comprador-test@example.com
MERCADOPAGO_WEBHOOK_SECRET=example-webhook-secret
# Señas (OAuth marketplace): aplicación de Mercado Pago con OAuth habilitado.
# La URL de redirección registrada en la app es <NEXT_PUBLIC_APP_URL>/api/mercadopago/oauth/callback.
MP_OAUTH_CLIENT_ID=example-client-id
MP_OAUTH_CLIENT_SECRET=example-client-secret
# Solo si la app de OAuth no es la misma que la de suscripciones: clave secreta de su webhook.
MP_OAUTH_WEBHOOK_SECRET=
# 32 bytes en base64 (openssl rand -base64 32). Cifra los tokens de los profesionales;
# si se pierde o cambia, hay que volver a conectar todas las cuentas.
MP_TOKEN_ENCRYPTION_KEY=example-base64-32-bytes
SKIP_WEBHOOK_SIGNATURE_VERIFICATION=false

# Web Push (notificaciones PWA). Opcional: si faltan, las push quedan desactivadas.
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=example-vapid-public-key
VAPID_PRIVATE_KEY=example-vapid-private-key
VAPID_SUBJECT=mailto:notificaciones@kineflow.ar
